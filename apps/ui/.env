# Permanent private voting (shutter-elgamal). Leave this false unless the hub and
# sequencer this UI talks to run private voting and a keyper committee is live.
# While false, the UI doesn't have any private voting options.
#
# To enable it for a deployment:
#   1. Deploy the hub and sequencer from this release, and run the hub migration
#      (apps/hub/migrations/001-private-voting.sql).
#   2. Bring up the keyper committee and coordinator
#      (docs/private-voting/DEPLOYMENT_SETUP.md).
#   3. Set VITE_TE_ENABLED=true and rebuild the UI.
#
# To try it against a local stack, set the flag below to true and add:
#   VITE_LOCAL_HUB_URL=http://localhost:3000/graphql
#   VITE_LOCAL_SEQUENCER_URL=http://localhost:3001
VITE_TE_ENABLED=false
