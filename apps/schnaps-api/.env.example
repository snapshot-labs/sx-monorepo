DATABASE_URL=postgres://postgres:default_password@localhost:5432/checkpoint
ADMIN_ADDRESS='0x8C28Cf33d9Fd3D0293f963b1cd27e3FF422B425c'
# Discord webhook for payment notifications
DISCORD_WEBHOOK_URL=
# Discord webhook for expiration notifications
DISCORD_EXPIRATION_WEBHOOK_URL=

# Stripe API key. Get the test-mode one (sk_test_...) from
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

SENTRY_DSN=

# Envio HyperSync token, makes replays much faster. Falls back to the RPC when unset.
HYPERSYNC_API_TOKEN=

# Only for `bun run withdraw --propose`: private key of a Safe owner or proposer
SAFE_PROPOSER_KEY=
# Safe Transaction Service API key (https://developer.safe.global), optional
SAFE_API_KEY=
