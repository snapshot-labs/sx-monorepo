# Environment for docker-compose.yml. Copy to .env and replace every 0x... with a
# real value; each key says how to create one.
# Setup: docs/private-voting/DEPLOYMENT_SETUP.md.

# --- Snapshot services -------------------------------------------------------
# MySQL's root password. Hex only: it goes into the hub's and sequencer's database
# URLs.
#   python3 -c "import secrets; print(secrets.token_hex(16))"
MYSQL_ROOT_PASSWORD=

# Signs sequencer receipts. Not a funded wallet; a throwaway is fine locally.
#   python3 -c "import secrets; print('0x'+secrets.token_bytes(32).hex())"
SEQ_RELAYER_PK=0x...
SEQ_AUTH_SECRET=1dfd84a695705665668c260222ded178d1f1d62d251d7bee8148428dac6d0487
WALLETCONNECT_PROJECT_ID=e6454bd61aba40b786e866a69bd4c5c6

# The sequencer's credential-issuing key. It signs each voter's eligibility
# credential, which binds the voting power their private ballot is counted with.
# Without it, private proposals cannot be created. Rotate it only when no private
# proposal is open or waiting to start: every proposal created before the rotation
# accepts no more votes (the votes cast before it still count).
#   python3 -c "import secrets; print('0x'+secrets.token_bytes(32).hex())"
TE_ELIGIBILITY_PRIVATE_KEY=0x...

# One URL per keyper, from the people who operate them. Each keyper's address is
# read from its /status when a private proposal is created; two URLs reporting the
# same address are refused. Every keyper must be reachable then, or creation fails.
# To run a keyper yourself, see step 1b of DEPLOYMENT_SETUP.md.
TE_KEYPERS=https://keyper1.example,https://keyper2.example,https://keyper3.example

# The quorum: how many keypers must act together. Must be a strict majority of
# the committee, so 2 for 3 keypers.
TE_THRESHOLD_T=2

# The coordinator's address, i.e. the address of COORDINATOR_SIGNING_KEY below. The
# hub accepts a published result signed by no other key, so the two must match.
TE_RESULT_PUBLISHER_ADDRESS=0x...

# --- The coordinator ---------------------------------------------------------
# Part of `docker compose up -d`. Both values below are required: if either is
# unset, compose starts no service at all, even for public voting only.
#
# Its address must also be TE_RESULT_PUBLISHER_ADDRESS above and
# COORDINATOR_IDENTITY in every keyper's env (DEPLOYMENT_SETUP.md step 1a).
#   python3 -c "import secrets; print('0x'+secrets.token_bytes(32).hex())"
COORDINATOR_SIGNING_KEY=0x...

# Secret for the keypers' write relay. Each keyper gets its own token from the
# coordinator, so this is never copied into a keyper's env.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
COORDINATOR_API_TOKEN=

# Optional; the defaults suit this compose file.
# COORDINATOR_PORT=8400
# COORDINATOR_POLL_S=30.0
# SHUTTER_GOVERNANCE_PROTOCOL_DATA_LAYER_URL=http://te-data-layer:3002

# The protocol image the coordinator runs. Keypers must run the same tag.
# SHUTTER_GOVERNANCE_PROTOCOL_IMAGE=ghcr.io/shutter-network/shutter-governance-protocol:0.1.0


# Denominator for weighted vote splits: 100 means percentages.
TE_WEIGHTED_BUDGET=100

# The largest tally search the coordinator can solve; it sets every private
# proposal's `scale`. Set it to match the coordinator's RAM. The default suits about
# 0.5 GB; 2 GB, which suits most deployments, is 5.1e13. Full table:
# docs/private-voting/README.md ("Coordinator sizing").
TE_SOLVER_CEILING=1e12

# Seconds before start by which a private proposal's key ceremony must finish.
MIN_DKG_LEAD_TIME_S=180

# Where the browser reaches the sequencer: the hub redirects /api/scores/:id here
# to finalise closed proposals. Defaults to http://localhost:${SEQ_PORT:-3001}; set
# your public sequencer URL in a real deployment.
# SEQUENCER_PUBLIC_URL=https://seq.example.org

# --- Optional: ports and logging --------------------------------------------
# Change a port only if it clashes with something on this machine.
# HUB_PORT=3000
# SEQ_PORT=3001
# TE_DATA_LAYER_PORT=3002
# TE_DATA_LAYER_LOG_LEVEL=info

# --- Optional: private-voting tuning -----------------------------------------
# Threads that check private ballots. Unset means one per CPU core, minus one.
# TE_VERIFY_WORKERS=
# How often the sequencer copies a published result into the proposal's scores.
# TE_TALLY_POLL_MS=5000
# How long the translator waits for the hub before answering 502.
# HUB_TIMEOUT_MS=10000
# A Snapshot API key issued for that hub, sent by the translator. Needed only when
# the hub rate-limits (RATE_LIMIT_DATABASE_URL set); an unknown key is refused with
# 401 on every request. With it set, restrict port 3002 to the keypers. See
# DEPLOYMENT_SETUP.md step 1a.
# HUB_API_KEY=
