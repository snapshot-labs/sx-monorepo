# Cross-language digest and crypto vectors: byte-compared against the values
# generated by the protocol's Python. Line-ending conversion would corrupt that
# comparison into false drift, so pin them.
apps/hub/test/fixtures/geg-*.json text eol=lf
apps/ui/src/helpers/__fixtures__/geg-*.json text eol=lf
packages/geg-parity/vectors/**/*.json text eol=lf

# Shell scripts are executed inside Linux containers (e.g. the MySQL init
# script mounted into the mysql container). They must keep LF endings or the
# shebang breaks on a CRLF checkout.
*.sh text eol=lf
