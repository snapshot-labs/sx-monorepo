{
  "name": "sx-monorepo",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:snapshot-labs/sx-monorepo.git"
  },
  "type": "module",
  "scripts": {
    "dev": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=ui...",
    "dev:interactive": "node --experimental-strip-types --no-warnings=ExperimentalWarning ./scripts/dev-interactive.ts",
    "dev:electron": "TURBO_TELEMETRY_DISABLED=1 turbo run dev:electron",
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
    "build:electron": "TURBO_TELEMETRY_DISABLED=1 ELECTRON=true turbo run build:electron",
    "test": "TURBO_TELEMETRY_DISABLED=1 turbo run test --filter=!hub --filter=!sequencer --filter=!sx-evm",
    "test:integration": "TURBO_TELEMETRY_DISABLED=1 turbo run test:integration --filter=!hub --filter=!sequencer",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:headed": "playwright test --config=playwright.config.ts --headed",
    "lint": "stage lint && TURBO_TELEMETRY_DISABLED=1 turbo run lint",
    "lint:fix": "stage lint --fix && TURBO_TELEMETRY_DISABLED=1 turbo run lint:fix",
    "lint:unused": "knip",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck",
    "docs": "cd docs && bunx mintlify dev --port 3006",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@inquirer/prompts": "^7.10.1",
    "@playwright/test": "^1.56.1",
    "@stage-labs/config": "0.1.0-beta.5",
    "@types/decompress": "^4.2.7",
    "decompress": "^4.2.1",
    "eslint": "^9.0.0",
    "knip": "^6.14.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "^2.8.0",
    "typescript": "^5.8.3"
  },
  "resolutions": {
    "error-ex": "1.3.2",
    "ofetch": "1.3.3",
    "prettier": "3.2.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "contracts/*",
    "packages/*"
  ]
}
