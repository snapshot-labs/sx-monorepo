# Keyper operator .env — one committee member, run independently.
#   cp .env.keyper.example .env.keyper1     # then fill in your values
#   docker compose -p keyper1 -f docker-compose.keyper.yml --env-file .env.keyper1 up -d
#
# `-p` is required, and each keyper needs its own project name, KEYPER_PORT and
# KEYPER_STATE_DIR_HOST -- otherwise they overwrite each other's shares.

# Your keyper's secp256k1 private key (SECRET). Its address must be a member of
# the election's KeyperSet / config.keypers[]. Give this address to the admin.
KEYPER_SIGNING_KEY=0x<64 hex>

# The admin's coordinator Ethereum address (public; received out-of-band)
COORDINATOR_IDENTITY=0x<40 hex>

# (No relay token here: the coordinator pushes it over the sealed /auth/bootstrap
#  channel, and the keyper persists it. You only pre-share COORDINATOR_IDENTITY.)

# The admin's public URLs (reads / write-relay). For local split testing these
# point at host.docker.internal; set real URLs for a multi-machine deploy.
# Reads: the BASE url of whatever serves the port contract -- in this deployment
# that is Snapshot's translator on :3002, and the keyper appends `/port` itself.
# (8500 is geg's own `api` service, which this topology does not run.)
GEG_API_URL=http://host.docker.internal:3002
COORDINATOR_URL=http://host.docker.internal:8400

# This keyper's listen + host-publish port. MUST match this keyper's endpoint in
# TE_KEYPERS on the Snapshot side (gen-env.py defaults keyper N to
# host.docker.internal:810N).
KEYPER_PORT=8101

# Host dir for this keyper's Fernet-encrypted state, relative to this repo. Give
# each local instance its own path (keyper-state1, keyper-state2, ...) so they do
# not overwrite each other. Losing it makes any election still awaiting decryption
# undecryptable.
KEYPER_STATE_DIR_HOST=./keyper-state1

# How long (seconds past voting_end) this keyper keeps its per-election secret
# shares before the prune loop drops them. There is no tally deadline, so this is
# the only bound on how late a tally can still decrypt. Default 90 days.
KEYPER_SECRET_TTL_S=7776000
